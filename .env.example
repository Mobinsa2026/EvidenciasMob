# ─── Supabase ────────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API
SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# ⚠️ SOLO servidor. Nunca la expongas en el frontend ni la subas a GitHub.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Evidencias

# ─── Sesiones ─────────────────────────────────────────────────────────────────
# Secreto que firma las cookies de sesión (HMAC-SHA256). Obligatorio: sin él el
# login no funciona. Mínimo 16 caracteres; genera uno con:
#   openssl rand -hex 32
# ⚠️ Si lo cambias, todas las sesiones activas se invalidan (re-login).
SESSION_SECRET=

# ─── Borrado de evidencias ───────────────────────────────────────────────────
# Contraseña que se pide al eliminar una evidencia. Solo la conoce el
# responsable autorizado. Si la dejas vacía, el botón de eliminar no aparece.
# Ponla entre comillas si empieza con # o contiene espacios.
DELETE_PASSWORD="cambia-esta-contrasena"

# ─── Anti-spam (opcional) ────────────────────────────────────────────────────
# Si defines ambas, se activa la verificación con Cloudflare Turnstile.
# Déjalas vacías para mantener el captcha desactivado.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
